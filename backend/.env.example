# Copy this file to backend/.env for local overrides. Never commit backend/.env.
APP_NAME="GitFox AI Code Reviewer"

# Comma-separated browser origins, without paths or wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use the same local password in both settings below. Placeholders only.
# Port 5433 avoids the existing local PostgreSQL service on 5432.
# Compose receives POSTGRES_PASSWORD via --env-file backend/.env.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+psycopg://gitfox:replace_me@127.0.0.1:5433/gitfox

# Optional until GitHub and AI integrations are implemented. Keep keys server-side.
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Patch selection limits. Character counts apply to diff text, not token counts.
MAX_REVIEW_FILES=10
MAX_PATCH_CHARS=20000
MAX_FILE_PATCH_CHARS=10000
