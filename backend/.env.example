# Copy to backend/.env for local overrides. Never commit backend/.env.
APP_NAME="GitFox AI Code Reviewer"

# Comma-separated local frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Placeholder for the database setup step; no connection is required yet.
DATABASE_URL=postgresql+psycopg://gitfox:replace_me@localhost:5433/gitfox

# Optional until integrations are implemented. Keep keys server-side.
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
